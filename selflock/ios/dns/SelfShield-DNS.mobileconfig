<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Profil DNS filtrant — couche de blocage supplémentaire à l'échelle de
  TOUT l'appareil (toutes les apps, tous les navigateurs, Wi-Fi et 4G/5G).

  Résolveur : Cloudflare for Families "1.1.1.3" (DoH) — bloque malware +
  contenu adulte au niveau DNS. Alternative plus stricte : AdGuard Family
  (https://dns-family.adguard.com/dns-query).

  Anti-contournement :
   - PayloadRemovalDisallowed = true : le profil ne peut pas être retiré
     depuis les Réglages une fois installé (hors effacement de l'appareil).
   - Pour un retrait possible mais protégé par mot de passe (détenu par la
     personne de confiance), remplacez PayloadRemovalDisallowed par un
     payload com.apple.profileRemovalPassword.

  Installation : envoyer ce fichier sur l'iPhone (AirDrop/Mail), l'ouvrir,
  puis Réglages > Général > VPN et gestion de l'appareil > Installer.
-->
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadType</key>
            <string>com.apple.dnsSettings.managed</string>
            <key>PayloadIdentifier</key>
            <string>com.example.selfshield.dns</string>
            <key>PayloadUUID</key>
            <string>A3F2C4D8-1D01-4E5A-B10C-0A1B2C3D4E01</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadDisplayName</key>
            <string>DNS filtrant SelfShield</string>
            <key>DNSSettings</key>
            <dict>
                <key>DNSProtocol</key>
                <string>HTTPS</string>
                <key>ServerURL</key>
                <string>https://family.cloudflare-dns.com/dns-query</string>
                <key>ServerAddresses</key>
                <array>
                    <string>1.1.1.3</string>
                    <string>1.0.0.3</string>
                    <string>2606:4700:4700::1113</string>
                    <string>2606:4700:4700::1003</string>
                </array>
            </dict>
            <key>ProhibitDisablement</key>
            <false/>
        </dict>
    </array>
    <key>PayloadDisplayName</key>
    <string>SelfShield — DNS filtrant (adulte + malware)</string>
    <key>PayloadDescription</key>
    <string>Force la résolution DNS via Cloudflare for Families (blocage du contenu adulte au niveau réseau, toutes apps confondues).</string>
    <key>PayloadIdentifier</key>
    <string>com.example.selfshield.profile</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>A3F2C4D8-1D01-4E5A-B10C-0A1B2C3D4E02</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadRemovalDisallowed</key>
    <true/>
</dict>
</plist>
